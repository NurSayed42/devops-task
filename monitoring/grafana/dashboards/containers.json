    {
      "type": "timeseries",
      "title": "CPU usage relative to limit",
      "description": "Sustained 100% means the container is being CPU-throttled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\"}[$__rate_interval])) / sum by (name) (container_spec_cpu_quota{name=~\"$container\"} / container_spec_cpu_period{name=~\"$container\"})",
          "legendFormat": "{{name}}",
          "range": true,
          "instant": false
