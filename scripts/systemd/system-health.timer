[Unit]
Description=Run the server health check every 5 minutes
Documentation=https://github.com/NurSayed42/devops-task/blob/main/docs/system-health.md

[Timer]
# Every 5 minutes on the wall clock (:00, :05, ...), first run 1 minute after boot.
OnCalendar=*:0/5
OnBootSec=1min
AccuracySec=15s
Unit=system-health.service

[Install]
WantedBy=timers.target
