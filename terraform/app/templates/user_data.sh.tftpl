#!/bin/bash
# First-boot bootstrap for ${environment}. Rendered by Terraform (templatefile).
set -euo pipefail
exec > >(tee -a /var/log/devops-task-bootstrap.log) 2>&1

echo "Installing Docker"
dnf install -y docker
systemctl enable --now docker

install -d -m 0755 /etc/devops-task /var/lib/devops-task

# Non-secret runtime configuration passed to the container.
cat > /etc/devops-task/app.env <<'EOF'
APP_ENV=${environment}
LOG_LEVEL=${log_level}
EOF

# Settings for the deploy script.
cat > /etc/devops-task/deploy.conf <<'EOF'
AWS_REGION=${aws_region}
LOG_GROUP=${log_group}
HOST_PORT=${host_port}
APP_ENV_FILE=/etc/devops-task/app.env
EOF

# scripts/deploy.sh from the repo, base64-encoded to survive templating.
echo '${deploy_script_b64}' | base64 -d > /usr/local/bin/deploy-app
chmod 0755 /usr/local/bin/deploy-app

%{ if image_uri != "" ~}
/usr/local/bin/deploy-app '${image_uri}'
%{ else ~}
echo "No image_tag given: the release pipeline will perform the first deploy."
%{ endif ~}
echo "Bootstrap finished"
